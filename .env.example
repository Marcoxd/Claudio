# ============================================================
#  Kuri — configuración
#  Copia este archivo a .env y llena los valores.
# ============================================================

# --- Marca (cámbiala si revendes el bot) --------------------
APP_NAME=Kuri
APP_TAGLINE=Tus finanzas, en un chat
OWNER_NAME=

# --- Telegram -----------------------------------------------
# Token que te da @BotFather
TELEGRAM_TOKEN=
# Cualquier cadena secreta; Telegram la manda en cada webhook
TELEGRAM_WEBHOOK_SECRET=pon-aqui-algo-largo-y-aleatorio
# IDs de Telegram con acceso, separados por coma.
# Si lo dejas vacío, el PRIMER usuario que escriba /start queda como dueño.
ALLOWED_USER_IDS=

# --- Google AI Studio (Gemini) ------------------------------
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Base de datos ------------------------------------------
# Local:    sqlite+aiosqlite:///./data/gastos.db
# Neon:     postgresql://usuario:clave@host/db   (se convierte solo a asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./data/gastos.db

# --- Web ----------------------------------------------------
# URL pública https del servicio. Con https se registra el webhook solo.
BASE_URL=http://localhost:8000
# Token del panel: quien tenga el enlace ve tus finanzas. Hazlo largo.
DASHBOARD_TOKEN=pon-aqui-algo-largo-y-aleatorio

# --- Localización -------------------------------------------
CURRENCY=USD
CURRENCY_SYMBOL=$
TIMEZONE=America/Guayaquil
# true si prefieres 1.234,56 en vez de 1,234.56
LOCALE_DECIMAL_COMMA=false

# --- Colchón ------------------------------------------------
BUFFER_NAME=Colchón
BUFFER_INITIAL=0

LOG_LEVEL=INFO
